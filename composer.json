{
    "name": "kejkej/notification-preferences",
    "description": "A Laravel package for notification preferences.",
    "keywords": [
        "laravel",
        "notifications",
        "preferences"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Kuba Kaliszczak",
            "email": "dev@kejkej.pl"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "KejKej\\NotificationPreferences\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KejKej\\NotificationPreferences\\NotificationPreferencesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.3",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.2"
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "test": "@php vendor/bin/phpunit --colors=always",
        "lint": "@php vendor/bin/pint --test",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "clean-cache": "@php -r \"if (is_file('.phpunit.result.cache')) { unlink('.phpunit.result.cache'); }\" && rm -rf build/phpstan",
        "quality": [
            "@test",
            "@lint",
            "@analyse"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    }
}
